# Copy to .env and fill in the keys you need. Only the provider you run needs a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: where the extracted dataset (images + question index) is cached. Default: ./data
# VLMBENCH_DATA_DIR=/path/to/scratch/visualoverload
# Optional: HuggingFace cache location on the cluster
# HF_HOME=/path/to/scratch/hf
